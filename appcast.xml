        <item>
            <title>0.1.36</title>
            <pubDate>Wed, 07 Oct 2026 03:38:49 +0000</pubDate>
            <sparkle:version>85</sparkle:version>
            <sparkle:shortVersionString>0.1.36</sparkle:shortVersionString>
            <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
            <sparkle:hardwareRequirements>arm64</sparkle:hardwareRequirements>
            <description sparkle:format="markdown"><![CDATA[- The dictation bubble opens at its final size instead of flashing a wide empty
  bar. Cursor placement settles before it appears, so a slow caret lookup no
  longer makes it jump across the screen.
- Saying "period" at the end of a sentence now ends it, even without a pause:
  "I had salmon for dinner period" types "I had salmon for dinner." instead
  of "dinner, period." Phrases like "billing period" or "the Jurassic period"
  keep the word.
]]></description>
            <enclosure url="https://github.com/noahdevkagan/rhino-releases/releases/download/v0.1.36/Rhino-0.1.36.dmg" length="16383820" type="application/octet-stream" sparkle:edSignature="45i/hybfDgU+JCbUzMtiHDsyUFhKMf3O37cujF0IRtK92mAjv/KbfC0GV2OqZCV/1p44S8LXYCl+eYIWwujKAg=="/>
